#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        sw0 = &hud_button;
        vibration0 = &hud_vibration;
    };

    chosen {
        zephyr,display = &hud_oled;
    };

    buttons {
        compatible = "gpio-keys";

        hud_button: button_0 {
            label = "HUD button";

            /*
             * Grove D0/D1 connector:
             * signal is assumed to be XIAO D0 / GPIO1.
             *
             * Grove Button:
             * released = low
             * pressed  = high
             */
            gpios = <&gpio0 1 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;

            zephyr,code = <INPUT_KEY_0>;
        };
    };

    outputs {
        compatible = "gpio-leds";

        hud_vibration: vibration_motor {
            label = "HUD vibration motor";

            /*
             * Grove D2/D3 connector:
             */
            gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        };
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    hud_oled: ssd1306@3c {
        compatible = "solomon,ssd1306";
        reg = <0x3c>;

        width = <128>;
        height = <64>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;

        segment-remap;
        com-invdir;

        status = "okay";
    };
};