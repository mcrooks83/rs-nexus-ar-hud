cat > .gitignore <<'EOF'
# Zephyr build output
build/
build-*/
twister-out/
out/

# Zephyr generated files
*.elf
*.hex
*.bin
*.map
*.uf2
*.lst
*.dts
*.config
*.config.old
zephyr.dts
edt.pickle
compile_commands.json

# CMake / Ninja
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
build.ninja
.ninja_deps
.ninja_log
rules.ninja

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example

# VS Code / editor
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Local tooling / secrets
.local/
*.pem
*.key
*.crt

# Debug/probe artifacts
JLink.log
JLinkRTTViewer.log
RTT*.log
EOF